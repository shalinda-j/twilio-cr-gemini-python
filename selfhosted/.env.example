# Gemini
GOOGLE_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# Speech-to-Text (faster-whisper). small = better Sinhala; base/tiny = lighter CPU.
WHISPER_MODEL="small"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE="int8"

# Text-to-Speech: "google" (English + Sinhala, needs gcp-key.json) or "piper" (free, English)
TTS_PROVIDER="google"
TTS_VOICE_EN="en-US-Standard-C"
TTS_VOICE_SI="si-LK-Standard-A"

# Server
AUDIOSOCKET_PORT="8090"

# Dashboard reporting (optional). Leave URL empty to disable.
DASHBOARD_INGEST_URL="http://127.0.0.1:8000/api/internal/ingest"
INGEST_TOKEN="generate_another_random_string"

# Turn detection (milliseconds)
SILENCE_MS_END="800"
MIN_SPEECH_MS="300"
