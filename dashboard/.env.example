# Database (SQLite by default; for Postgres: postgresql+psycopg2://user:pass@host/db)
DATABASE_URL="sqlite:///./data/dashboard.db"

# First company + admin login (created on first boot)
COMPANY_NAME="My Company"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change_this_now"

# Security
JWT_SECRET="generate_a_long_random_string"
JWT_EXPIRE_HOURS="12"

# Shared secret the voice server uses to post call events
INGEST_TOKEN="generate_another_random_string"
